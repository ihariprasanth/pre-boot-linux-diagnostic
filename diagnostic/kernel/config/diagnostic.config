# PLDDS diagnostic kernel — config FRAGMENT (merged onto tinyconfig).
# Minimal footprint: only what's needed to boot, read hardware sysfs,
# and get a network link up for the report upload. No GUI, no sound,
# no unrelated filesystems.

# --- Base ---
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- procfs/sysfs (agent's collectors read these) ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- PCI / hardware enumeration (pci.rs, gpu.rs collectors) ---
CONFIG_PCI=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# --- Storage (storage.rs collector + boot media) ---
CONFIG_BLOCK=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_VIRTIO_BLK=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y

# --- NTFS (local-log mode: write the report onto the Windows C:
# partition instead of uploading it over the network — see
# diagnostic/agent/src/localsave.rs). Mainline NTFS3, read-write. ---
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=n

# --- USB (usb.rs collector) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID=y
CONFIG_USB_HID=y

# --- Network (network.rs collector + report upload) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y
CONFIG_R8169=y

# --- TTY / console (so you can actually see it boot) ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y

# --- GRUB/EFI boot chain ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- Explicitly off (keep it minimal) ---
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_WIRELESS is not set
