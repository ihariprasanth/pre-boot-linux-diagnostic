# Copy to .env (already gitignored) and fill in your real values.
# Never commit real values or paste them into chat / issues / PRs.

# Supabase: Project Settings -> Database -> Connection string -> URI
# (direct connection, port 5432). If using the pgbouncer pooler (port
# 6543) instead, keep pool_pre_ping and add ?pgbouncer=true.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

PLDDS_SCHEMA_MAJOR=1
PLDDS_ENV=development

# Phase 7 — real HTTPS in production. Either:
#  (a) terminate TLS at a reverse proxy / your host (Render, Fly, etc.
#      all do this for you) and run uvicorn plain HTTP behind it — most
#      common, nothing to set here; or
#  (b) run uvicorn with its own cert:
#      uvicorn app.main:app --ssl-keyfile=key.pem --ssl-certfile=cert.pem
# Either way, set the agent's PLDDS_SERVER_URL to https:// and
# PLDDS_REQUIRE_TLS=1 for any non-dev deployment.

# Phase 12 — security hardening knobs. All optional; defaults shown are
# safe for local dev. See docs/security-hardening.md for the full pass.
# PLDDS_MAX_BODY_BYTES=2097152
# PLDDS_REGISTER_RATE_LIMIT=20/minute
# PLDDS_DIAGNOSTICS_RATE_LIMIT=60/minute
# PLDDS_READ_RATE_LIMIT=120/minute
# PLDDS_NONCE_RETENTION_SECONDS=600
# PLDDS_TRUSTED_PROXY_HOPS=1
